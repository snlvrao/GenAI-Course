# Everything you create lives under my-work/. These are the parts of it that
# should never be committed: secrets, the environment, and anything a lab
# regenerates. Your own code and notes under my-work/ ARE tracked, because that
# is the record of what you built.

# Your keys. Leaked API keys get scraped off public repositories within minutes.
my-work/.env

# The environment. Rebuild it from the setup page rather than committing it.
my-work/.venv/

__pycache__/
*.pyc

# Lab output
*.db
my-work/labs/**/output/

# rebuilt by reconcile.py on every build, not authored
tools/module_content.json

# generated by the labs, not source
my-work/labs/**/tinygpt.pt
my-work/labs/**/model_config.json
my-work/labs/**/tokenizer.json
my-work/labs/**/sample.txt
my-work/labs/**/adapter/
