# Copy this file to ".env" (a dot, then the word env, nothing before the dot).
# Keep ONLY the block for the path you chose on setup.html. Delete the rest.
# Never commit the real .env. The .gitignore here already excludes it.

# ---------------------------------------------------------------------------
# PATH 1: FULLY OFFLINE
# A model on your own machine. No account, no key, no internet, no limits.
# Install Ollama, run: ollama pull llama3.2:3b
# Then these two lines are the whole file.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b


# ---------------------------------------------------------------------------
# PATH 2: FREE HOSTED
# A free API key. No card needed. Needs internet, and has a daily cap.
#   Groq             https://console.groq.com
#   Google AI Studio https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=paste_your_key_here
# GEMINI_API_KEY=


# ---------------------------------------------------------------------------
# PATH 3: YOUR OWN KEY
# You already pay for one of these. Set LLM_PROVIDER to match.
# Options: openai  anthropic  gemini  deepseek  together  openrouter
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=


# ---------------------------------------------------------------------------
# Optional, any path. Forces one specific model instead of the default.
# Use it when a default model name has been retired by the provider.
# ---------------------------------------------------------------------------
# LLM_MODEL=llama-3.1-8b-instant
